{
  "name": "websearch-skill",
  "version": "1.2.0",
  "private": true,
  "description": "网络搜索与网页正文提取(bing/baidu/marginalia + Chromium 浏览器兜底 + Mozilla Readability 正文提取)",
  "type": "module",
  "main": "./scripts/lib/index.mjs",
  "exports": {
    ".": "./scripts/lib/index.mjs",
    "./cli": "./scripts/lib/cli.mjs",
    "./engines/*": "./scripts/lib/engines/*.mjs"
  },
  "files": [
    "scripts/"
  ],
  "scripts": {
    "search": "node scripts/websearch.mjs search",
    "fetch": "node scripts/websearch.mjs fetch",
    "fixtures": "node scripts/update-fixtures.mjs",
    "setup:semantic": "node scripts/setup-semantic.mjs",
    "test": "node --experimental-test-module-mocks --test \"scripts/lib/tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"scripts/lib/tests/integration/*.test.mjs\"",
    "test:all": "node --test \"scripts/lib/tests/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "optionalDependencies": {
    "playwright": "^1.55.0",
    "puppeteer-core": "^25.4.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.0.1",
    "json5": "^2.2.3",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4"
  }
}
